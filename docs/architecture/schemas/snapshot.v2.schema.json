          "title": "Id",
          "type": "string"
        },
        "junction_class": {
          "enum": [
            "post-beam",
            "post-sill",
            "brace",
            "joist-beam",
            "rafter-peak",
            "rafter-foot",
            "purlin-rafter"
          ],
          "title": "Junction Class",
          "type": "string"
        },
        "kind": {
          "const": "Connection",
          "title": "Kind",
          "type": "string"
        },
        "location_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "title": "Location M",
          "type": "array"
        },
        "member_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Member Ids",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "schema_version",
        "junction_class",
        "connection_type",
        "member_ids",
        "location_m",
        "generation_key"
