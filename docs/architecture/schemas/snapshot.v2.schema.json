    "Connection": {
      "additionalProperties": false,
      "description": "A generated junction of exactly two members (D054, MODEL-005 §4.4). Makes no capacity claim.",
      "properties": {
        "connection_type": {
          "enum": [
            "PEGGED_MORTISE_TENON",
            "BRIDLE",
            "HOUSED_DOVETAIL",
            "STEEL_KNIFE_PLATE",
            "JOIST_HANGER"
          ],
