        "status": {
          "enum": [
            "MISSING",
            "QUEUED",
            "COMPUTING",
            "CURRENT",
            "FAILED",
            "STALE",
            "UNAVAILABLE",
            "SUPERSEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "suitability": {
          "const": "preliminary",
          "default": "preliminary",
          "title": "Suitability",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Message"
