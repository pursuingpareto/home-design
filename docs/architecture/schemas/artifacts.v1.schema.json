{
  "$defs": {
    "ArtifactEnvelope": {
      "additionalProperties": false,
      "description": "Common envelope for every artifact response (artifacts.md §2).",
      "properties": {
        "artifact_type": {
          "enum": [
            "plan2d",
            "mesh3d",
            "timber_schedule",
            "preliminary_estimate"
          ],
          "title": "Artifact Type",
          "type": "string"
        },
        "claims": {
          "$ref": "#/$defs/Claims",
          "default": {
            "construction_approved": false,
            "permit_ready": false,
            "structurally_verified": false
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Message"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generated At"
        },
        "generator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generator Id"
        },
        "generator_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generator Version"
        },
        "head": {
          "title": "Head",
          "type": "boolean"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Fingerprint"
        },
        "payload": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Source Revision Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "MISSING",
            "QUEUED",
            "COMPUTING",
            "CURRENT",
            "FAILED",
            "STALE",
            "UNAVAILABLE",
            "SUPERSEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "suitability": {
          "const": "preliminary",
          "default": "preliminary",
          "title": "Suitability",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "artifact_type",
        "project_id",
        "source_revision_id",
        "head",
        "generator_id",
        "generator_version",
        "input_fingerprint",
        "generated_at",
        "status",
        "warnings",
        "error"
      ],
      "title": "VS-01 artifact envelope (artifacts.md §2)",
      "type": "object"
    },
