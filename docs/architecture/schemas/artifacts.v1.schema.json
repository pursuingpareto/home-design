{
  "$defs": {
    "ArtifactEnvelope": {
      "additionalProperties": false,
      "description": "Common envelope for every artifact response (artifacts.md §2).",
      "properties": {
        "artifact_type": {
          "enum": [
            "plan2d",
            "mesh3d",
            "timber_schedule",
            "preliminary_estimate"
          ],
          "title": "Artifact Type",
          "type": "string"
        },
        "claims": {
          "$ref": "#/$defs/Claims",
          "default": {
            "construction_approved": false,
            "permit_ready": false,
            "structurally_verified": false
          }
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Message"
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generated At"
        },
        "generator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generator Id"
        },
        "generator_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generator Version"
        },
        "head": {
          "title": "Head",
          "type": "boolean"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Fingerprint"
        },
        "payload": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Payload"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Source Revision Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "MISSING",
            "QUEUED",
            "COMPUTING",
            "CURRENT",
            "FAILED",
            "STALE",
            "UNAVAILABLE",
            "SUPERSEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "suitability": {
          "const": "preliminary",
          "default": "preliminary",
          "title": "Suitability",
          "type": "string"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/Message"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "artifact_type",
        "project_id",
        "source_revision_id",
        "head",
        "generator_id",
        "generator_version",
        "input_fingerprint",
        "generated_at",
        "status",
        "warnings",
        "error"
      ],
      "title": "VS-01 artifact envelope (artifacts.md §2)",
      "type": "object"
    },
    "Claims": {
      "additionalProperties": false,
      "properties": {
        "construction_approved": {
          "const": false,
          "default": false,
          "title": "Construction Approved",
          "type": "boolean"
        },
        "permit_ready": {
          "const": false,
          "default": false,
          "title": "Permit Ready",
          "type": "boolean"
        },
        "structurally_verified": {
          "const": false,
          "default": false,
          "title": "Structurally Verified",
          "type": "boolean"
        }
      },
      "title": "Claims",
      "type": "object"
    },
    "Manifest": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ManifestEntry"
          },
          "title": "Artifacts",
          "type": "array"
        },
        "head": {
          "title": "Head",
          "type": "boolean"
        },
        "project_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Project Id",
          "type": "string"
        },
        "revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Revision Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "revision_id",
        "head",
        "artifacts"
      ],
      "title": "Manifest",
      "type": "object"
    },
    "ManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact_type": {
          "title": "Artifact Type",
          "type": "string"
        },
        "generator_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generator Version"
        },
        "input_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Input Fingerprint"
        },
        "source_revision_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Source Revision Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "MISSING",
            "QUEUED",
            "COMPUTING",
            "CURRENT",
            "FAILED",
            "STALE",
            "UNAVAILABLE",
            "SUPERSEDED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "status",
        "source_revision_id",
        "generator_version",
        "input_fingerprint"
      ],
      "title": "ManifestEntry",
      "type": "object"
    },
    "Message": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "Message",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Definitions for artifacts.md §2-3, generated from backend/src/homedesign/dependencies/envelope.py; do not edit by hand. Validate an envelope against #/$defs/ArtifactEnvelope and a manifest against #/$defs/Manifest.",
  "title": "VS-01 artifact envelope and manifest (ART-001)"
}
