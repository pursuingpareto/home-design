          },
          {
            "$ref": "#/$defs/Connection"
          },
          {
            "$ref": "#/$defs/Section"
          },
          {
            "$ref": "#/$defs/Material"
          },
          {
            "$ref": "#/$defs/WallSystem"
          },
          {
            "$ref": "#/$defs/AssemblyDefinition"
          },
          {
            "$ref": "#/$defs/Wall"
          },
          {
            "$ref": "#/$defs/WallFramingPiece"
          },
          {
            "$ref": "#/$defs/Opening"
          }
        ]
      },
      "title": "Entities",
      "type": "array"
    },
    "model_schema_version": {
      "const": 3,
      "title": "Model Schema Version",
      "type": "integer"
    },
    "parent_revision_id": {
      "anyOf": [
