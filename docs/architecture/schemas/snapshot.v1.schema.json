          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "Building",
          "title": "Kind",
          "type": "string"
        },
        "level_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Level Ids",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "roof_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Roof Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "schema_version",
        "kind",
        "name",
        "footprint_id",
        "level_ids",
        "roof_id",
        "frame_system_id"
      ],
      "title": "Building",
      "type": "object"
    },
    "Footprint": {
