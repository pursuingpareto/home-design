          "title": "Actual Depth M",
          "type": "number"
        },
        "actual_width_m": {
          "title": "Actual Width M",
          "type": "number"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
