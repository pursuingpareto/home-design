          "type": "array"
        },
        "generation_key": {
          "title": "Generation Key",
          "type": "string"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "TimberMember",
          "title": "Kind",
          "type": "string"
        },
        "material_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Material Id",
          "type": "string"
        },
        "member_role": {
          "enum": [
            "POST",
            "BEAM",
            "FLOOR_JOIST",
            "RAFTER"
