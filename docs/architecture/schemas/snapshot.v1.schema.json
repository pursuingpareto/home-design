          "title": "Kind",
          "type": "string"
        },
        "origin_m": {
          "items": {
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Origin M",
          "type": "array"
        },
        "rotation_rad": {
          "title": "Rotation Rad",
          "type": "number"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "width_m": {
          "title": "Width M",
          "type": "number"
        }
